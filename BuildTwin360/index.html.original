              <div>
                <div style="font-weight:700;">Headquarters</div>
                <div style="color:var(--text-sky-light);">Software Development Center & Global Client Desk</div>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <form id="triovexa-contact-form">
            <div class="form-group">
              <label for="form-name">Your Name / Company Name *</label>
              <input type="text" id="form-name" class="form-control" placeholder="e.g. Ramesh Textiles / Kumar Travels" required>
            </div>

            <div class="form-group">
              <label for="form-email">Mobile Number / Email *</label>
              <input type="text" id="form-email" class="form-control" placeholder="Mobile Number or Email" required>
            </div>

            <div class="form-group">
              <label for="form-service">Select Project Category</label>
              <select id="form-service" class="form-control">
                <option value="textile">Textiles / Garments / Dyeing Software</option>
                <option value="transport">Transport / Travels / Fleet App</option>
                <option value="shop">Shop Website & Billing App</option>
                <option value="custom">Fully Customized Software / App</option>
              </select>
            </div>

            <div class="form-group">
              <label for="form-message">Project Requirements Details</label>
              <textarea id="form-message" class="form-control" rows="4" placeholder="Mention your requirements, features needed, or budget..."></textarea>
            </div>

            <button type="submit" class="btn btn-sky" style="width:100%;">
              <i class="ri-send-plane-fill"></i> Send Project Request
            </button>
          </form>
        </div>
      </div>
    </div>
