      <div class="contact-grid">
        <div>
          <h3>Contact TRIOVEXA</h3>
          <p style="color:var(--text-sky-light); margin-top:0.5rem;">
            Ready to digitize your business? Fill in the form or call us directly. Our team responds within 2 hours.
          </p>

          <div class="contact-info-list">
            <div class="contact-info-item">
              <div class="contact-icon"><i class="ri-phone-fill"></i></div>
              <div>
                <div style="font-weight:700;">Direct Phone / WhatsApp</div>
                <div style="color:var(--text-sky-light);">+91 98765 43210</div>
              </div>
            </div>
            <div class="contact-info-item">
              <div class="contact-icon"><i class="ri-mail-fill"></i></div>
